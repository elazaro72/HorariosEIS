!-- activity_main.xml -->
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2196F3"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horarios EIS"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_eis"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnCTC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ciclo Técnico Común"
        android:background="#FFFFFF"
        android:textColor="#2196F3"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnCTE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ciclo Técnico Específico"
        android:background="#FFFFFF"
        android:textColor="#2196F3"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escuela Industrial Superior - FIQ - UNL"
        android:textColor="#FFFFFF"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"/>
</LinearLayout>
